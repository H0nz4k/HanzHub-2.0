[Unit]
Description=Whiteboard Hub web interface

[Service]
User=hanz
WorkingDirectory=/opt/whiteboard-hub
Environment=WHITEBOARD_HUB_CONFIG=/opt/whiteboard-hub/config.yaml
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/whiteboard-hub/venv/bin/python -m flask --app app run --host 127.0.0.1 --port 8099
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
