#!/bin/sh
# Run in the stock initramfs before mountroot and return via normal firmware boot.
PREREQ=""
case "$1" in
    prereqs) echo "$PREREQ"; exit 0 ;;
esac
case " $(cat /proc/cmdline) " in
    *" hub2.offline-img=1 "*) ;;
    *) exit 0 ;;
esac
echo "HUB2 recovery: starting offline SD backup" >/dev/console
/bin/bash /hub2-recovery/run.sh >/dev/console 2>&1
echo "HUB2 recovery: returning to normal boot" >/dev/console
sync
/bin/busybox reboot -f
# Never fall through to mountroot when recovery was selected.
while :; do sleep 30; done
