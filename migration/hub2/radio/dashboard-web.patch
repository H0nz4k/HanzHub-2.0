+    def radio_presets(self):
+        host = self.headers.get("Host")
+        path = urlsplit(self.path)
+        match = re.fullmatch(r"/api/radio/presets(/(?:[1-9][0-9]{0,9}))?", path.path)
+        methods = {"GET", "HEAD", "POST"} if match and not match[1] else {"PATCH", "DELETE"}
+        if not match or path.query or self.command not in methods:
+            return self.send_content('{"detail":"Neplatná cesta předvolby."}'.encode(), "application/json", 404)
+        origins = self.headers.get_all("Origin") or []
+        write = self.command not in ("GET", "HEAD")
+        same_origin = origins in ([f"http://{host}"], [f"https://{host}"])
+        server_host, server_port = self.connection.getsockname()[:2]
+        allowed_hosts = {f"{server_host}:{server_port}"}
+        if ip_address(server_host).is_loopback:
+            allowed_hosts.add(f"localhost:{server_port}")
+        if (self.headers.get_all("Host") != [host] or host not in allowed_hosts or not self.local_data_allowed()
+                or ((origins or write) and not same_origin)
+                or (write and self.headers.get("Sec-Fetch-Site") not in (None, "same-origin"))):
+            return self.send_content('{"detail":"Přístup je omezen na místní Dashboard."}'.encode(), "application/json", 403)
+        body = None
+        if self.command in ("POST", "PATCH"):
+            lengths = self.headers.get_all("Content-Length") or []
+            if (len(lengths) != 1 or not re.fullmatch(r"[0-9]{1,5}", lengths[0])
+                    or not 0 < int(lengths[0]) <= 8192 or self.headers.get("Transfer-Encoding")
+                    or self.headers.get_content_type() != "application/json"):
+                return self.send_content('{"detail":"Neplatný formát předvolby."}'.encode(), "application/json", 400)
+            self.connection.settimeout(5)
+            body = self.rfile.read(int(lengths[0]))
+        try:
+            request = Request(origin(4014) + "/api/v1/presets" + (match[1] or ""), data=body,
+                              method="GET" if self.command == "HEAD" else self.command,
+                              headers={"Content-Type": "application/json"})
+            with urlopen(request, timeout=4) as response:
+                return self.send_content(response.read(262144), "application/json", response.status)
+        except HTTPError as exc:
+            return self.send_content(exc.read(8192), "application/json", exc.code)
+        except OSError:
+            return self.send_content('{"detail":"FM/SDR služba není dostupná."}'.encode(), "application/json", 503)
+
+    do_POST = do_PATCH = do_DELETE = radio_presets
+
